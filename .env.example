# Copy is NOT needed: run "pnpm configure" to generate .env with a password hash and VAPID keys.
# This file only documents the variables.

# Server listens on localhost only. Tailscale serve exposes it over HTTPS.
HOST='127.0.0.1'
PORT='8787'

# Generated by "pnpm configure". Never commit real values.
NONSTOP_PASSWORD_HASH=''
VAPID_PUBLIC_KEY=''
VAPID_PRIVATE_KEY=''
# VAPID_SUBJECT='mailto:you@example.com'

# auto = Secure cookie only over HTTPS (Tailscale). always | never also allowed.
COOKIE_SECURE='auto'
SESSION_DAYS='30'

# Daily backup at or after this hour (local time). Keeps the newest N backups.
BACKUP_HOUR='3'
BACKUP_KEEP_DAYS='14'

# Optional path overrides, relative to the repo root.
# DATA_DIR='data'
# BACKUP_DIR='backups'
